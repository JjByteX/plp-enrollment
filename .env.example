# Copy to .env.local and fill in. Never commit real values.
# Supabase Postgres connection string (transaction pooler), used by lib/db.ts
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<host>:6543/postgres
# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_. Settings > API > service_role key. Used to create staff accounts (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the Admissions intake call (app/api/admissions/intake). Server only. Generate with: openssl rand -hex 32
# Must equal the secret set in the PLP Admissions system. Never commit it.
ADMISSIONS_INTAKE_SECRET=
